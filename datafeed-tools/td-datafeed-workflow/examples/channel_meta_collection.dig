+transform:
  td>: queries/feed_meta_collection.sql
  create_table: datafeed_meta_collection
  engine: presto

+validate:
  td>: queries/validate_meta_collection.sql
  store_last_results: true
  engine: presto

+assert_not_empty:
  if>: ${td.last_results.row_count == 0}
  _do:
    fail>: "ERROR: datafeed_meta_collection is empty (0 rows)"

+export:
  _export:
    feed_sql: feed_meta_collection
    feed_file_name: ${channels.meta_collection.file_name}
  call>: export.dig
