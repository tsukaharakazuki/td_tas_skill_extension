# One serialized pipeline for cart, browser, or both. No active schedule is shipped.
# Activate a schedule only in an approved customer-owned copy; do not run aliases
# concurrently. SQL tables are rebuildable staging; the shared ledger is append-only.
timezone: UTC

_export:
  config:
    !include : config/params.yml

+check_boolean_types:
  if>: ${![config.workflow.enabled,config.delivery.enabled,config.delivery.approved,config.personalization.products,config.personalization.recommendations,config.personalization.attributes,config.personalization.coupons,config.testing.enabled,config.testing.approved].every(function(v) { return typeof v == 'boolean'; })}
  _do:
    fail>: Enablement and approval flags must be YAML booleans, never quoted strings.

+check_names:
  if>: ${!/^[a-z][a-z0-9_]*$/.test(config.output.database) || !/^[a-z][a-z0-9_]*$/.test(config.output.prefix) || !/^[a-z][a-z0-9_]*\.[a-z][a-z0-9_]*( [a-z][a-z0-9_]*\.[a-z][a-z0-9_]*)*$/.test([config.sources.events,config.sources.identities,config.sources.recipients,config.sources.orders,config.sources.products,config.sources.recommendations,config.sources.attributes,config.sources.coupons,config.sources.history].join(' ')) || !/^[A-Za-z0-9_+/-]+$/.test(config.timezone)}
  _do:
    fail>: Use simple lower-case database/table identifiers and an IANA timezone; never SQL fragments.

+check_numbers:
  if>: ${![config.workflow.max_recipients,config.workflow.max_execution_lag_seconds,config.window.max_age_seconds,config.window.session_timeout_seconds,config.window.inactivity_seconds,config.window.expected_latency_seconds,config.scan.lookback_seconds,config.suppression.purchase_seconds,config.suppression.cart_seconds,config.frequency.window_seconds,config.frequency.per_kind,config.frequency.total,config.personalization.max_items,config.testing.expected_messages,config.testing.max_messages].every(function(v) { return typeof v == 'number' && isFinite(v) && Math.floor(v) == v && v >= 0; }) || config.window.session_timeout_seconds < 1 || config.workflow.max_execution_lag_seconds < 1 || config.frequency.window_seconds < 1}
  _do:
    fail>: Durations and limits must be nonnegative integers with positive timeouts and cap windows.

+check_overnight:
  if>: ${config.window.kind == 'overnight' && (!/^[0-2][0-9]:[0-5][0-9]:[0-5][0-9]$/.test(config.window.overnight_start) || !/^[0-2][0-9]:[0-5][0-9]:[0-5][0-9]$/.test(config.window.overnight_end) || config.window.overnight_start > '23:59:59' || config.window.overnight_end > '23:59:59' || config.window.overnight_start <= config.window.overnight_end)}
  _do:
    fail>: Overnight start/end must be valid HH:mm:ss and start must be later than end.

+check_configuration:
  if>: ${['cart','browser','both'].indexOf(config.mode) < 0 || ['rolling','overnight'].indexOf(config.window.kind) < 0 || ['rolling','calendar_day'].indexOf(config.frequency.period) < 0 || config.window.inactivity_seconds < config.window.session_timeout_seconds + config.window.expected_latency_seconds || config.personalization.max_items < 1 || config.personalization.max_items > 4 || config.workflow.max_recipients < 1 || config.frequency.per_kind < 1 || config.frequency.total < 1 || config.window.max_age_seconds <= config.window.inactivity_seconds || config.scan.lookback_seconds < Math.max(config.window.max_age_seconds, config.suppression.purchase_seconds, config.suppression.cart_seconds, config.frequency.window_seconds, 172800) + config.window.session_timeout_seconds}
  _do:
    fail>: Invalid mode, windows, scan coverage, caps or item limits; see README.

+effective_configuration:
  echo>: "mode=${config.mode}; window=${config.window.kind}; timezone=${config.timezone}; inactivity_seconds=${config.window.inactivity_seconds}; purchase_seconds=${config.suppression.purchase_seconds}; cart_suppression_seconds=${config.suppression.cart_seconds}; cap_period=${config.frequency.period}; cap_window_seconds=${config.frequency.window_seconds}; per_kind_cap=${config.frequency.per_kind}; total_cap=${config.frequency.total}; workflow_enabled=${config.workflow.enabled}; delivery_enabled=${config.delivery.enabled}"

+disabled:
  if>: ${!config.workflow.enabled}
  _do:
    echo>: "Disabled template: no TD reads, writes, exports or reservations."

+pipeline:
  if>: ${config.workflow.enabled}
  _do:
    +delivery_configuration:
      if>: ${config.delivery.enabled && (!config.delivery.approved || !config.delivery.connection || !config.delivery.workspace_id || (config.mode != 'browser' && !config.delivery.cart_campaign_id) || (config.mode != 'cart' && !config.delivery.browser_campaign_id))}
      _do:
        fail>: Delivery requires explicit approval and only the enabled mode's campaign(s).

    +ensure_shared_ledger:
      td>: queries/ensure_history.sql
      database: ${config.output.database}
      engine: presto

    +events:
      td>: queries/events.sql
      database: ${config.output.database}
      engine: presto
      create_table: ${config.output.prefix}_events

    +candidates:
      td>: queries/candidates.sql
      database: ${config.output.database}
      engine: presto
      create_table: ${config.output.prefix}_candidates

    +products:
      if>: ${config.personalization.products}
      _do:
        td>: queries/load/products.sql
        database: ${config.output.database}
        engine: presto
        create_table: ${config.output.prefix}_products
      _else_do:
        td>: queries/empty/products.sql
        database: ${config.output.database}
        engine: presto
        create_table: ${config.output.prefix}_products

    +recommendations:
      if>: ${config.personalization.recommendations}
      _do:
        td>: queries/load/recommendations.sql
        database: ${config.output.database}
        engine: presto
        create_table: ${config.output.prefix}_recommendations
      _else_do:
        td>: queries/empty/recommendations.sql
        database: ${config.output.database}
        engine: presto
        create_table: ${config.output.prefix}_recommendations

    +attributes:
      if>: ${config.personalization.attributes}
      _do:
        td>: queries/load/attributes.sql
        database: ${config.output.database}
        engine: presto
        create_table: ${config.output.prefix}_attributes
      _else_do:
        td>: queries/empty/attributes.sql
        database: ${config.output.database}
        engine: presto
        create_table: ${config.output.prefix}_attributes

    +coupons:
      if>: ${config.personalization.coupons}
      _do:
        td>: queries/load/coupons.sql
        database: ${config.output.database}
        engine: presto
        create_table: ${config.output.prefix}_coupons
      _else_do:
        td>: queries/empty/coupons.sql
        database: ${config.output.database}
        engine: presto
        create_table: ${config.output.prefix}_coupons

    +items:
      td>: queries/items.sql
      database: ${config.output.database}
      engine: presto
      create_table: ${config.output.prefix}_items

    +send_list:
      td>: queries/send_list.sql
      database: ${config.output.database}
      engine: presto
      create_table: ${config.output.prefix}_send_list

    +circuit_breaker:
      td>: queries/check_payload.sql
      database: ${config.output.database}
      engine: presto
      store_last_results: true

    +stop_unsafe_payload:
      if>: ${td.last_results.recipient_count > config.workflow.max_recipients || td.last_results.recipient_count != td.last_results.unique_email_count || (config.delivery.enabled && (td.last_results.execution_lag_seconds < 0 || td.last_results.execution_lag_seconds > config.workflow.max_execution_lag_seconds))}
      _do:
        fail>: Recipient breaker, deduplication or delivery execution-lag guard failed.

    +delivery:
      if>: ${config.delivery.enabled && td.last_results.recipient_count > 0}
      _do:
        # Reserve EXACTLY the frozen payload before any export. Reserved != delivered.
        # No automatic retries: ambiguous export results need provider reconciliation.
        +check_reservations:
          td>: queries/check_reservations.sql
          database: ${config.output.database}
          engine: presto
          store_last_results: true

        +stop_existing_signal:
          if>: ${td.last_results.existing_decision_count > 0}
          _do:
            fail>: Frozen payload contains a prior signal reservation; reconcile instead of retrying exports.

        +reserve:
          td>: queries/reserve.sql
          database: ${config.output.database}
          engine: presto
          job_retry: 0
          insert_into: ${config.sources.history}

        +cart:
          if>: ${config.mode != 'browser'}
          _do:
            td>: queries/export_cart.sql
            database: ${config.output.database}
            engine: presto
            job_retry: 0
            result_connection: ${config.delivery.connection}
            result_settings:
              type: treasure_engage_v1
              campaign_type: email
              campaign_model: always_on
              workspace_id: ${config.delivery.workspace_id}
              always_on_campaign_id: ${config.delivery.cart_campaign_id}
              batch_size: 1000
              thread_count: 1

        +browser:
          if>: ${config.mode != 'cart'}
          _do:
            td>: queries/export_browser.sql
            database: ${config.output.database}
            engine: presto
            job_retry: 0
            result_connection: ${config.delivery.connection}
            result_settings:
              type: treasure_engage_v1
              campaign_type: email
              campaign_model: always_on
              workspace_id: ${config.delivery.workspace_id}
              always_on_campaign_id: ${config.delivery.browser_campaign_id}
              batch_size: 1000
              thread_count: 1

    +summary:
      echo>: "Built ${config.mode} payload; recipients=${td.last_results.recipient_count}; delivery_enabled=${config.delivery.enabled}. Ledger entries are reservations, never delivery receipts."
