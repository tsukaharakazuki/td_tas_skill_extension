# Synthetic TEST exports only; disabled by default, no schedule and no real reads.
# Exact destinations/count/assets require approval even for a single test email.
timezone: UTC
_export:
  config:
    !include : config/params.yml

+check_boolean_types:
  if>: ${![config.workflow.enabled,config.delivery.enabled,config.delivery.approved,config.personalization.products,config.personalization.recommendations,config.personalization.attributes,config.personalization.coupons,config.testing.enabled,config.testing.approved].every(function(v) { return typeof v == 'boolean'; })}
  _do:
    fail>: Enablement and approval flags must be YAML booleans, never quoted strings.

+check_number_types:
  if>: ${![config.workflow.max_recipients,config.workflow.max_execution_lag_seconds,config.window.max_age_seconds,config.window.session_timeout_seconds,config.window.inactivity_seconds,config.window.expected_latency_seconds,config.scan.lookback_seconds,config.suppression.purchase_seconds,config.suppression.cart_seconds,config.frequency.window_seconds,config.frequency.per_kind,config.frequency.total,config.personalization.max_items,config.testing.expected_messages,config.testing.max_messages].every(function(v) { return typeof v == 'number' && isFinite(v) && Math.floor(v) == v && v >= 0; }) || config.personalization.max_items < 1 || config.personalization.max_items > 4}
  _do:
    fail>: Durations and limits must be finite nonnegative YAML integer numbers.

+test_disabled:
  if>: ${!config.testing.enabled}
  _do:
    echo>: "Synthetic test delivery disabled; no TD jobs or external sends."

+synthetic_test:
  if>: ${config.testing.enabled}
  _do:
    +validate_mode:
      if>: ${['cart','browser','both'].indexOf(config.mode) < 0 || ['smoke','fixture','full'].indexOf(config.testing.mode) < 0}
      _do:
        fail>: Invalid abandonment mode or synthetic test mode.

    +validate_recipients:
      if>: ${!config.testing.approved || !Array.isArray(config.testing.recipients) || !Array.isArray(config.testing.allowlist) || config.testing.recipients.length < 1 || !config.testing.recipients.every(function(r) { return typeof r == 'string' && /^[a-z0-9._%+-]+@[a-z0-9.-]+[.][a-z][a-z]+$/.test(r) && config.testing.allowlist.indexOf(r) >= 0; }) || config.testing.recipients.length != config.testing.recipients.filter(function(v,i,a) { return a.indexOf(v) == i; }).length}
      _do:
        fail>: Synthetic tests require approved, unique normalized recipients explicitly in the test allowlist.

    +validate_assets:
      if>: ${!config.testing.connection || !config.testing.workspace_id || config.testing.connection == config.delivery.connection || config.testing.workspace_id == config.delivery.workspace_id || (config.mode != 'browser' && (!config.testing.cart_campaign_id || [config.delivery.cart_campaign_id,config.delivery.browser_campaign_id].indexOf(config.testing.cart_campaign_id) >= 0)) || (config.mode != 'cart' && (!config.testing.browser_campaign_id || [config.delivery.cart_campaign_id,config.delivery.browser_campaign_id].indexOf(config.testing.browser_campaign_id) >= 0)) || (config.mode == 'both' && config.testing.cart_campaign_id == config.testing.browser_campaign_id)}
      _do:
        fail>: Isolated test connection/workspace/campaigns must be distinct from production and appropriate to the selected mode.

    +validate_message_count:
      if>: "${!/^[0-9]+$/.test(String(config.testing.expected_messages)) || !/^[0-9]+$/.test(String(config.testing.max_messages)) || config.testing.expected_messages < 1 || config.testing.max_messages < 1 || config.testing.expected_messages > config.testing.max_messages || config.testing.expected_messages != config.testing.recipients.length * (config.mode == 'both' ? 2 : 1) * (config.testing.mode == 'smoke' ? 1 : (config.testing.mode == 'fixture' ? 2 : 3))}"
      _do:
        fail>: Approved expected_messages must match recipients x kinds x variants and stay below max_messages.

    +summary:
      echo>: "Synthetic test mode=${config.testing.mode}; kind_mode=${config.mode}; expected_messages=${config.testing.expected_messages}; no production sources or shared history will be read."

    +test_exports:
      for_each>:
        test_recipient: ${config.testing.recipients}
        test_kind: "${config.mode == 'both' ? ['cart','browser'] : [config.mode]}"
        test_variant: "${config.testing.mode == 'smoke' ? ['normal'] : (config.testing.mode == 'fixture' ? ['normal','low_stock'] : ['minimal','normal','low_stock'])}"
      _do:
        td>: queries/test_fixture.sql
        database: ${config.output.database}
        engine: presto
        job_retry: 0
        result_connection: ${config.testing.connection}
        result_settings:
          type: treasure_engage_v1
          campaign_type: email
          campaign_model: always_on
          workspace_id: ${config.testing.workspace_id}
          always_on_campaign_id: "${test_kind == 'cart' ? config.testing.cart_campaign_id : config.testing.browser_campaign_id}"
          batch_size: 1
          thread_count: 1
