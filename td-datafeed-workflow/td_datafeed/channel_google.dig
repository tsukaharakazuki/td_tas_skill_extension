+transform:
  td>: queries/feed_google_merchant.sql
  create_table: datafeed_google_merchant
  engine: presto

+validate:
  td>: queries/validate_google_merchant.sql
  store_last_results: true
  engine: presto

+assert_not_empty:
  if>: ${td.last_results.row_count == 0}
  _do:
    fail>: "ERROR: datafeed_google_merchant is empty (0 rows)"

+export:
  _export:
    feed_sql: feed_google_merchant
    feed_file_name: ${channels.google_merchant.file_name}
  call>: export.dig
